{
    "name": "jaiva",
    "displayName": "Jaiva! Editor Integration",
    "description": "Provides VSCode with support for Jaiva! files.",
    "version": "5.1.0",
    "engines": {
        "vscode": "^1.134.0"
    },
    "publisher": "yetnt",
    "icon": "./images/jaiva-full-logo.png",
    "categories": [
        "Programming Languages"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/yetnt/jaiva-vscode"
    },
    "scripts": {
        "compile": "tsc -p ./"
    },
    "contributes": {
        "languages": [
            {
                "id": "jaiva",
                "aliases": [
                    "Jaiva!",
                    "Jaiva",
                    "jaiva"
                ],
                "extensions": [
                    ".jva",
                    ".jiv",
                    ".jaiva"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "snippets": [
            {
                "language": "jaiva",
                "path": "./snippets/jaiva.json"
            }
        ],
        "grammars": [
            {
                "language": "jaiva",
                "scopeName": "source.jaiva",
                "path": "./syntaxes/jaiva.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "jaiva.run",
                "title": "Jaiva: Run File"
            },
            {
                "command": "jaiva.runTokens",
                "title": "Jaiva: Export Tokens"
            },
            {
                "command": "jaiva.addRepository",
                "title": "Jaiva: Add Repository"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "jaiva.run",
                    "when": "editorLangId == jaiva",
                    "group": "navigation"
                },
                {
                    "command": "jaiva.runTokens",
                    "when": "editorLangId == jaiva",
                    "group": "navigation"
                }
            ]
        }
    },
    "main": "./dist/extension.js",
    "devDependencies": {
        "@types/node": "^26.6.4",
        "@types/vscode": "^1.140.0",
        "typescript": "^7.0.2",
        "vscode": "^1.1.37"
    }
}
