        {
            "type": "TFunction",
            "name": "F~f_permsOf",
            "exportSymbol": false,
            "toolTip": [
                {
                    "tagType": "GENERIC",
                    "description": "Gets the permissions of the file from a file."
                },
                {
                    "tagType": "parameter",
                    "description": "The file array to get the permissions from.",
                    "var": "file",
                    "type": "[]",
                    "optional": false
                },
                {
                    "tagType": "returns",
                    "description": "A function that allows you to return a specific permission or all permissions as an array."
                },
                {
                    "tagType": "devnote",
                    "description": "Unlike other functions, this one may require a bit of functional thinking. It returns a function that you can call to get specific permissions or all permissions at once."
                },
                { "tagType": "from", "version": "5.0.0" },
                {
                    "tagType": "example",
                    "codeblock": [
                        "maak permissions <- f_permsOf(f_this)!",
                        "khuluma(permissions())! @ Prints all permissions as an array [canRead, canWrite, canExecute]",
                        "khuluma(permissions(\"read\"))! @ Prints whether the file can be read (true/false)",
                        "khuluma(permissions(\"r\"))! @ Prints whether the file can be read (true/false)",
                        "khuluma(permissions(0))! @ Prints whether the file can be read (true/false)",
                        "@ Similarly for \"write\"/\"w\"/1 and \"execute\"/\"x\"/2"
                    ]
                }
            ],
            "lineNumber": -1,
            "args": ["file"],
            "isArgOptional": [false],
            "varArgs": false,
            "body": null
        },
