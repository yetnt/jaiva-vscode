        {
            "type": "TFunction",
            "name": "F~f_new",
            "exportSymbol": false,
            "toolTip": [
                {
                    "tagType": "GENERIC",
                    "description": "Creates a new file with the given properties at the given file."
                },
                {
                    "tagType": "parameter",
                    "description": "The path to the new file to createFunction. Along with the file name and extension",
                    "var": "path",
                    "type": "string",
                    "optional": false
                },
                {
                    "tagType": "parameter",
                    "description": "The content the file should hold. Either a string or an array of strings.",
                    "var": "content",
                    "type": "idk",
                    "optional": false
                },
                {
                    "tagType": "parameter",
                    "description": "Whether or not the file can be read. Defaults to true",
                    "var": "canRead",
                    "type": "boolean",
                    "optional": true
                },
                {
                    "tagType": "parameter",
                    "description": "Whether the file can be written to or not. Defaults to true",
                    "var": "canWrite",
                    "type": "boolean",
                    "optional": true
                },
                {
                    "tagType": "parameter",
                    "description": "Whether the file can be executed or not. Defaults to true.",
                    "var": "canExecute",
                    "type": "boolean",
                    "optional": true
                },
                {
                    "tagType": "returns",
                    "description": "A boolean `true` if the file could be created. `false` otherwise."
                },
                {
                    "tagType": "example",
                    "codeblock": [
                        "maak success <- f_new(\"data/newFile.txt\", arrLit(\"Hello, World!\", \"This is a new file.\"), true, true, false)!",
                        "if (success) ->",
                        "    khuluma(\"File created successfully!\")!",
                        "<~ else ->",
                        "    khuluma(\"Failed to createFunction file.\")!",
                        "<~"
                    ]
                },
                { "tagType": "from", "version": "2.0.1" }
            ],
            "lineNumber": -1,
            "args": ["path", "content", "canRead", "canWrite", "canExecute"],
            "isArgOptional": [false, false, true, true, true],
