                {
                    "tagType": "GENERIC",
                    "description": "Returns the current file's properties and contents."
                },
                {
                    "tagType": "devnote",
                    "description": "Returns an array containing the current file's properties \n [fileName, fileDir, [contents], [canRead?, canWrite?, canExecute?]]"
                },
                {
                    "tagType": "devnote",
                    "description": "Once again, if we are inside the REPL, we just return static content. (Does not represent the REPL)"
                },
                { "tagType": "from", "version": "1.0.1" },
                {
                    "tagType": "example",
                    "codeblock": [
                        "f_this[0]! @ holds the file name",
                        "f_this[1]! @ holds the file directory",
                        "khuluma(\"File contents: \" + f_this[2])! @ holds the file contents as an array",
                        "khuluma(\"Can we write to this file? \" + f_this[3][1])! @ holds the file permissions"
                    ]
                }
            ],
