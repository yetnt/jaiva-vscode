        {
            "type": "TFunction",
            "name": "F~flat",
            "exportSymbol": false,
            "toolTip": [
                {
                    "tagType": "GENERIC",
                    "description": "Attempts to flatten (at the top level) the given arrays array1 and array2 into 1 single array."
                },
                {
                    "tagType": "parameter",
                    "description": "Variable amount of arrays to input",
                    "var": "arrays",
                    "type": "[]",
                    "optional": true
                },
                {
                    "tagType": "devnote",
                    "description": "If there are any type mismatches in array1, it will be ignored and the same check is done to array2 and so on. Therefore this function will **always** return an array, whether or not it was successful."
                },
                { "tagType": "from", "version": "1.0.0-beta.2" },
                {
                    "tagType": "example",
                    "codeblock": [
                        "maak array1 <-| 1, 2, 3!",
                        "maak array2 <-| 4, 5, 6!",
                        "maak array3 <- flat(array1, array2)! @ Flattens the two arrays into a new one.",
                        "khuluma(array3)! @ Prints [1, 2, 3, 4, 5, 6]"
                    ]
                }
            ],
            "lineNumber": -1,
            "args": ["arrays"],
            "isArgOptional": [true],
            "varArgs": true,
            "body": null
        },
        {
            "type": "TFunction",
            "name": "F~arrLit",
            "exportSymbol": false,
            "toolTip": [
                {
                    "tagType": "GENERIC",
                    "description": "Creates an array literal from the given elements. This is useful if you want to createFunction an array without declaring it to a variable. For example, `arrLit(1, 2, 3)` will return `[1, 2, 3]`. This is needed as Jaiva doesnt have square bracket syntax"
                },
                {
                    "tagType": "parameter",
                    "description": "Variable amount of elements to take in and turn into a single array.",
                    "var": "elements",
                    "type": "[]",
                    "optional": true
                },
                {
                    "tagType": "returns",
                    "description": "The input given, as an array"
                },
                { "tagType": "from", "version": "3.0.0" },
                {
                    "tagType": "example",
                    "codeblock": [
                        "maak array1 <- arrLit(1, 2, 3, \"hello\", aowa, idk)! @ Creates an array with mixed types.",
                        "maak array2 <-| 1, 2, 3, \"hello\", aowa, idk! @ Creates an array with mixed types. (Same as above but with maak syntax)",
                        "maak array3 <- arrLit()! @ Creates an empty array.",
                        "khuluma(array1)! @ Prints [1, 2, 3, \"hello\", aowa, idk]",
                        "khuluma(array3)! @ Prints []",
                        "khuluma(array1 = array2)! @ Prints aowa (false) (I am not implementing array equality via `=` operator anytime soon. It is the exact same array though.)"
                    ]
                }
            ],
            "lineNumber": -1,
            "args": ["elements"],
            "isArgOptional": [true],
            "varArgs": true,
            "body": null
        },
        {
            "type": "TFunction",
            "name": "F~scope",
            "exportSymbol": false,
            "toolTip": [
                { "tagType": "from", "version": "4.1.1" },
                {
                    "tagType": "GENERIC",
                    "description": "Configures the current scope to whichever settings provided."
                },
                {
                    "tagType": "parameter",
                    "description": "variable amount of strings to input.",
                    "var": "strings",
                    "type": "[]",
                    "optional": true
                },
                { "tagType": "returns", "description": "idk" },
                {
                    "tagType": "devnote",
                    "description": "The following are accepted strings: \n    \"sw\" to suppress all warnings. \n    \"ew\" to elevate all warnings. \n    \"constant\" to make all symbols given constant. and \n    \"strict\" which toggles \"ew\" and \"constant\"\n"
                },
                {
                    "tagType": "example",
                    "codeblock": [
                        "scope(\"freezeAll\")!",
                        "kwenza af(a) ->",
                        "    khutla a!",
                        "<~",
                        "af <- 10! @ Errors as the variable af cannot be written to.",
                        "",
                        "@ Or",
                        "",
                        "scope(\"ew\")!",
                        "@* depr $> This fucntion is deprecated.",
                        "kwenza af(a) ->",
                        "    khutla a!",
                        "<~",
                        "af()! @ Errors as the usual deprecation warning is now a fatal error. (Crashes the interpreter)"
                    ]
                }
            ],
            "lineNumber": -1,
            "args": ["strings"],
            "isArgOptional": [true],
            "varArgs": true,
            "body": null
        },
